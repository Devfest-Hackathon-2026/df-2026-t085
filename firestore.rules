rules_version = '2';
// UNSAID の Firestore ルール（案）。Gemini の結果（facts / clarification の中身 / translation / error）は
// Cloud Run（Admin SDK、ルールの対象外）だけが書く。端末が書けるのは下の決めた項目だけ。
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(sessionId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/sessions/$(sessionId)).data.members;
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    match /sessions/{sessionId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      // 作る人は自分を members に入れる
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      // QR で参加: members に自分を1人足すだけの更新を許す（セッション id を知っている人だけが参加できる）
      allow update: if signedIn() && onlyChanges(['members'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.removeAll(resource.data.members).hasOnly([request.auth.uid]);

      match /messages/{messageId} {
        allow read: if isMember(sessionId);

        // 発言を作る: 本文と from だけ。status は必ず analyzing から始める
        allow create: if isMember(sessionId)
          && request.resource.data.keys().hasOnly(['from', 'original', 'status', 'createdAt'])
          && request.resource.data.from in ['patient', 'doctor']
          && request.resource.data.status == 'analyzing'
          && request.resource.data.original is string
          && request.resource.data.original.size() > 0
          && request.resource.data.original.size() <= 1000;

        allow update: if isMember(sessionId) && (
          // 患者: 確認質問への回答（clarification.answer だけを書き換える）
          (resource.data.status in ['clarifying', 'error'] && onlyChanges(['clarification'])
            && request.resource.data.clarification.diff(resource.data.clarification).affectedKeys().hasOnly(['answer'])
            && request.resource.data.clarification.answer.type in ['option', 'free_text', 'unsure'])
          // 患者: 逆翻訳を確認して送信
          || (resource.data.status == 'confirmed' && request.resource.data.status == 'sent'
            && onlyChanges(['status', 'sentAt']))
          // 医師: 受け取った
          || (resource.data.status == 'sent' && request.resource.data.status == 'received'
            && onlyChanges(['status', 'receivedAt']))
        );
        allow delete: if false;
      }
    }
  }
}
