{
  "type": "object",
  "properties": {
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "doctor_gloss": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["symptom", "onset", "frequency", "severity", "medication", "allergy", "other"]
          },
          "negated": { "type": "boolean" },
          "uncertain": { "type": "boolean" },
          "time": { "type": "string" }
        },
        "required": ["text", "doctor_gloss", "kind", "negated", "uncertain"]
      }
    },
    "needs_clarification": { "type": "boolean" },
    "clarifications": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "target": { "type": "string" },
          "question": { "type": "string" },
          "ui_type": { "type": "string", "enum": ["choice", "text"] },
          "options": {
            "type": "array",
            "maxItems": 4,
            "items": { "type": "string" }
          }
        },
        "required": ["target", "question", "ui_type", "options"]
      }
    }
  },
  "required": ["facts", "needs_clarification", "clarifications"]
}
